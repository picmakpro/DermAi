# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Affiliate API Keys (Optional)
SEPHORA_API_KEY=your_sephora_api_key
DOUGLAS_API_KEY=your_douglas_api_key
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag

# Environment
NODE_ENV=development

# V2 Pipeline Configuration
DERMAI_PIPELINE=v2
# Options: 'legacy' | 'v2'
# legacy: Use existing 2-step pipeline
# v2: Use new 3-step pipeline (Vision -> Routine -> Products)

# AI Provider Configuration (Safe Mode Defaults)
DERMAI_AI_PROVIDER=mock
# Options: 'mock' | 'openai'
# mock: Use mock provider for local testing (no API calls) - SAFE DEFAULT
# openai: Use OpenAI API (requires OPENAI_API_KEY)

# Per-Step Provider Overrides (optional - defaults to mock if not set)
# Uncomment and modify only if you need specific step overrides
# DERMAI_STEP1_PROVIDER=mock
# DERMAI_STEP2_PROVIDER=mock
# DERMAI_STEP3_PROVIDER=mock

# OpenAI Configuration (only if you want to enable OpenAI)
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TEXT_MODEL=gpt-4o

# A/B Testing Flags (V2 Pipeline only)
DERMAI_AB_PRICE_EFFICIENCY=0.2
# Weight for price efficiency in product selection (0.0-1.0)
# Higher values prioritize budget-friendly products

DERMAI_AB_DURATION_MULT=1.0
# Multiplier for phase durations (0.5-2.0)
# 0.5: Faster transitions, 2.0: Slower, more conservative transitions
